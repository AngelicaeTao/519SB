# ==========================================
# 519SB 聊天室 - 配置模板
# 把这个文件复制一份，重命名为 config.properties 即可使用
# ==========================================

# 服务器端口（ngrok 会转发到这个端口）
port=8443

# 网站标题（会显示在聊天页面顶部）
site.title=519SB-Chat

# keystore 文件路径
keystore.path=keystore.p12

# keystore 密码（必须与 setup.bat 生成证书时的密码一致）
keystore.password=changeit

# SQLite 数据库文件路径（存聊天记录、图片、用户）
db.file=data/chat.db

# 历史消息保留条数（超出后自动删除最旧的）
max.history=200

# 单张图片最大字节数（默认 5MB）
max.image.size=5242880

# 前端压缩图片最大宽度（像素，越大越清晰越占流量）
image.max.width=800

# 前端压缩图片 JPEG 质量（0.0 到 1.0，越小越省流量越模糊）
image.quality=0.6

# HTTP 线程池大小（同时处理请求的数量）
thread.pool.size=16

# 门禁验证码（首次访问需要输入的）
access.code=519666233

# 默认管理员账号。首次启动时会用这组凭据创建管理员；之后改密码以数据库为准。
# ★ 公开部署前务必改掉——默认值写在代码里，任何人 clone 后都知道。
admin.username=admin
admin.password=admin123

# 登录失败限制：在 login.window.ms 毫秒内，同一账号最多尝试 login.max.attempts 次
login.max.attempts=5
login.window.ms=60000

# 消息发送限制：在 send.window.ms 毫秒内，同一用户最多发送 send.max.count 条
send.max.count=5
send.window.ms=3000

# Session 有效期（天）。超过这个时间没操作就自动退出登录
# 常用值：1（一天）、7（一周）、30（一个月）、365（一年）
session.ttl.days=30

# 可信反向代理地址（逗号分隔）。只有当直连请求来自这些地址时，才采信 X-Forwarded-For。
# 默认只信本机，因为 ngrok 就跑在本机、由它转发外网流量。
# 如果换成 Cloudflare / frp / nginx 等部署，把它们的前置地址加进来，否则 IP 限流会被伪造头绕过。
trusted.proxies=127.0.0.1,::1

# ===== 上传配额（按用途分别计算）=====
# 每个用户在每个用途下独立计数，互不挤占：
#   message  聊天图片
#   avatar   头像
#   post     帖子配图
#   comment  评论/回复配图
#
# 下面两个不带用途的键是历史配置，只对 message / post 生效
# （当初就是为聊天图和帖子图设计的）。
# 头像和评论的默认值分别是 10张/5MB 和 200张/150MB，
# 想改就用带用途后缀的键，例如：
#   max.image.count.per.user.avatar=10
#   max.image.bytes.per.user.avatar=5242880

# 单个用户可上传的图片总字节上限（默认 200MB），防止灌满磁盘
max.image.bytes.per.user=209715200

# 单个用户可上传的图片条数上限（默认 300）
max.image.count.per.user=300

# 头像：条数少、体积小，且只保留最近 5 张
# max.image.count.per.user.avatar=10
# max.image.bytes.per.user.avatar=5242880

# 评论配图
# max.image.count.per.user.comment=200
# max.image.bytes.per.user.comment=157286400

# 语音（聊天里录制的语音，单条最长 60 秒）
# max.image.count.per.user.voice=100
# max.image.bytes.per.user.voice=104857600

# 动态图（GIF / 动态 WebP，原样上传不压缩，所以比静态图大）
# max.image.count.per.user.anim=100
# max.image.bytes.per.user.anim=104857600

# 文件（聊天里分享的附件，强制以附件下载）
# max.image.count.per.user.file=100
# max.image.bytes.per.user.file=524288000

# 单个文件的大小上限（默认：图片/语音/动图 5MB、文件 20MB）
# 注意：上传接口的请求体上限本身是 25MB（见 ChatServer.MAX_BODY_UPLOAD），
# 所以这里的值不应超过它，否则文件还没走到类型校验就会被挡掉。
# max.media.size.file=20971520

# 媒体保留时长（毫秒）。不写则：聊天图 24 小时、语音 7 天，其余永久保留。
# 帖子图和评论图不建议设保留期——帖子/评论会永久保留，媒体被删了就成了裂图。
# 语音可以设，因为聊天记录本身有条数上限，旧消息本来就会被裁掉。
# image.retention.ms.message=86400000
# image.retention.ms.voice=604800000

# SSE 长连接空闲多久后自动断开（毫秒，默认 10 分钟）
# 用于回收挂死的连接，避免它们长期占用「每用户 3 条 / 每 IP 10 条」的名额
sse.idle.timeout.ms=600000

# 服务器启动完成后是否自动打开浏览器（默认开）
# 会先向 ngrok 的本地 API（127.0.0.1:4040）要公网地址，然后打开 <公网地址>/login，
# 也就是你发给朋友的那个链接；检测不到 ngrok 时退回 https://localhost:<端口>。
# 无图形界面的环境（服务器、Docker）建议改成 false
auto.open.browser=true

# 自动打开的目标路径（默认登录页；想直接进聊天室或论坛改成 /chat 、/posts）
auto.open.path=/login

# ===== 屏幕共享 =====
# 方案是「定时截屏推流」而不是 WebRTC：抓屏 → canvas → JPEG → POST 给服务器，
# 服务器再用 multipart/x-mixed-replace 转发给观看者。
# 优点：纯 HTTP，能穿 ngrok，浏览器端一个 <img> 就能显示。
# 代价：流量远大于 WebRTC——720p 约 40~80KB/帧，30 帧就是 1.2~2.4 MB/s，
#       而且**每个观看者都要服务器再复制一份**。ngrok 免费版每月 1GB，
#       按这个速率十几分钟就用完，所以下面几个参数要按实际需要往下调。
#
# 「同一时刻只允许一个人分享屏幕」在服务端用占用标记保证，不可配置。

# 目标帧率（每秒截图数，1~60）。
# 默认 15：屏幕内容大部分时间静止，15 帧看不出差别，流量却直接减半。
# 只有屏幕上有视频或快速滚动时才值得调高到 30。
screen.fps=15

# 截图缩放后的最大宽度（像素，160~3840）。这是省流量最有效的参数。
screen.max.width=1280

# JPEG 质量（0.1~1.0）。调低能显著减小单帧体积，代价是文字变糊。
screen.quality=0.5

# 同时允许的观看者上限（1~50）。每多一路观看，服务器就多复制一份帧。
screen.max.viewers=5

# 多久收不到新帧就认为分享者掉线、自动解除占用（毫秒，1000~60000）。
# 没有这个兜底，分享者直接关掉页面就会把位置永久占住，别人再也抢不到。
screen.idle.timeout.ms=6000

# 单帧字节上限（4096 ~ 4MB），防止借这个接口塞超大请求体
screen.max.frame.bytes=524288

# 多久收不到观看者的心跳就把它移出观看列表（毫秒，3000~120000）。
# 观看者异常断开（断网、关笔记本盖子、浏览器被强杀）时 TCP 处于半开状态，
# 服务器往那个流写帧不会立刻报错，会把一个已经没人的连接一直算作观看者，
# 分享者于是持续满帧推流、白烧流量。观看端每隔 1/3 这个时间发一次
# 几百字节的心跳来证明自己还在看。
screen.viewer.timeout.ms=12000